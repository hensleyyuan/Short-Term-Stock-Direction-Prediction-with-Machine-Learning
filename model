import pandas as pd
from xgboost import XGBClassifier
from sklearn.metrics import accuracy_score, f1_score, roc_auc_score, confusion_matrix, classification_report
from pathlib import Path

print("=== XGBoost + Early Stopping ===\n")

data_dir = Path.cwd()

train_df = pd.read_csv(data_dir / "Train_Scaled.csv")
val_df   = pd.read_csv(data_dir / "Val_Scaled.csv")

target_col = 'Target_Next_Day'

return_related = [col for col in train_df.columns if 'Return_roll' in col]
exclude_cols = ['Date', 'Ticker', target_col, 'Return', 'Target_Return'] + return_related

X_train = train_df.drop(columns=exclude_cols)
y_train = train_df[target_col]

X_val = val_df.drop(columns=exclude_cols)
y_val = val_df[target_col]

print(f"Features: {X_train.shape[1]}")

model = XGBClassifier(
    n_estimators=2000,
    learning_rate=0.0147,
    max_depth=4,
    min_child_weight=4,
    subsample=0.85,
    colsample_bytree=0.61,
    gamma=0.054,
    reg_alpha=0.556,
    reg_lambda=0.111,
    random_state=42,
    n_jobs=-1,
    eval_metric='auc',
    early_stopping_rounds=50
  )

model.fit(
    X_train, y_train,
    eval_set=[(X_val, y_val)],
    verbose=50
)

print(f"Best Iteration: {model.best_iteration}")
print(f"AUC: {model.best_score:.4f}")

y_val_pred = model.predict(X_val)
y_val_proba = model.predict_proba(X_val)[:, 1]

print(f"\nAccuracy : {accuracy_score(y_val, y_val_pred):.4f}")
print(f"F1 Score : {f1_score(y_val, y_val_pred):.4f}")
print(f"ROC-AUC  : {roc_auc_score(y_val, y_val_proba):.4f}")

print("\n Confusion Matrix")
print(confusion_matrix(y_val, y_val_pred))

print("\n Classification")
print(classification_report(y_val, y_val_pred, digits=4))

print("\n Importances")
importances = pd.DataFrame({
    'feature': X_train.columns,
    'importance': model.feature_importances_
}).sort_values('importance', ascending=False)
print(importances.head(20))
