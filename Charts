bin_acc = []
for i in range(len(bins)-1):
    mask = (y_proba >= bins[i]) & (y_proba < bins[i+1])
    if mask.sum() > 0:
        bin_acc.append((y_pred[mask] == y_true[mask]).mean())
    else:
        bin_acc.append(np.nan)
ax8.plot(bin_centers, bin_acc, marker='o', linewidth=2)
ax8.axhline(0.5, color='gray', linestyle='--')
ax8.set_title('Accuracy by Confidence Bin', fontsize=12, fontweight='bold')
ax8.set_xlabel('Predicted Probability')
